<?xml version="1.0"?>
<ruleset name="Braillewright">
    <description>Coding standards + security sniffs for the Braillewright theme (WordPress-Extra). Bundled third-party and generated assets are excluded.</description>

    <!-- What to scan (paths are relative to this file = repo root). -->
    <file>theme/braillewright</file>
    <file>tools</file>

    <!-- Only PHP; plus performance + readability args. -->
    <arg name="extensions" value="php"/>
    <arg name="parallel" value="8"/>
    <arg name="cache" value=".phpcs-cache"/>
    <arg name="colors"/>
    <arg value="sp"/><!-- s = show sniff codes, p = progress -->

    <!-- Exclusions: bundled third-party libs, compiled translations, vendor/build output. -->
    <exclude-pattern>*/tgm/*</exclude-pattern><!-- TGM Plugin Activation (vendored, not ours to restyle) -->
    <exclude-pattern>*/lib/plugin-update-checker/*</exclude-pattern><!-- YahnisElsts Plugin Update Checker (vendored GPL self-update lib; not ours to restyle) -->
    <exclude-pattern>*/languages/*</exclude-pattern><!-- .po/.mo/.pot data files -->
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/assets/*</exclude-pattern>
    <exclude-pattern>*.min.js</exclude-pattern>
    <exclude-pattern>*.min.css</exclude-pattern>

    <!-- Base standard: WordPress-Extra = WordPress-Core + best practices + the WordPress.Security.* sniffs. -->
    <rule ref="WordPress-Extra">

        <!--
            RETIRED BY DECISION 2026-08-27 (Aaron, round 2026-08-27-braillewright-codestyle-A).
            These two are switched OFF, visibly, with the reason recorded here. That is
            deliberately NOT the same as a baseline: a baseline leaves a rule switched on
            and hides its findings, so the gate claims to enforce something it does not.
            An excluded rule is honest - anyone reading this file can see it is off.

            1. Universal.Operators.StrictComparisons - 332 findings.
               phpcbf marks ALL of them auto-fixable and would rewrite == to ===, which is
               a BEHAVIOUR change, not a style change. Measured 2026-08-27: 70 findings at
               37 source lines across 5 files would have changed what the theme does,
               because WordPress returns bool false for an unset setting and the string
               '1' from a TEXT column. The worst would have put <a href="">Visit Page</a>
               on the front page of three live sites. Those 37 lines were repaired in the
               same change that added this exclusion; the remaining 295 are correct under
               both operators. Enforcing strict comparisons across a WordPress theme that
               reads options, theme mods and post meta is a trap, not a standard.
        -->
        <exclude name="Universal.Operators.StrictComparisons"/>

        <!--
            2. WordPress.PHP.YodaConditions - 308 findings.
               Pure house style with no correctness content, and no fixer exists, so every
               one would be a hand edit. Braillewright does not write Yoda conditions.
               Recorded as a style decision rather than carried as permanent noise.
        -->
        <exclude name="WordPress.PHP.YodaConditions"/>

        <!--
            3. WordPress.PHP.DiscouragedPHPFunctions.urlencode_urlencode - 6 findings.
               Aaron's decision, 2026-08-27, and it is a case where complying is a small
               REGRESSION rather than an improvement.

               The sniff prefers rawurlencode(). That rule exists to stop urlencode()
               being used for PATH segments, where a "+" is a literal plus rather than a
               space. All six sites here are QUERY-STRING values for Google Fonts, which
               is exactly what urlencode() is for.

               Measured on the real WordPress 7.1 running on TTT staging:

                 urlencode    + add_query_arg -> ...css?family=Open+Sans%3A400    canonical
                 raw          + add_query_arg -> ...css?family=Open Sans:400      broken
                 rawurlencode + add_query_arg -> ...css?family=Open%20Sans%3A400  non-canonical

               "+" is the form Google documents. Complying would change every multi-word
               font URL for no benefit.

               ⚠️ Recorded because it nearly became a false bug report: urlencode() feeding
               add_query_arg() LOOKS like double encoding, which would have broken every
               multi-word font on every site. Measured - add_query_arg does NOT re-encode.
               The live page confirms it: WordPress.com proxies the request and the family
               arrives as Roboto%3A300%2C300italic%2C400%2C700, working correctly.
        -->
        <exclude name="WordPress.PHP.DiscouragedPHPFunctions.urlencode_urlencode"/>

    </rule>

    <!-- Target a recent-but-stable WP for the deprecated-function checks. -->
    <config name="minimum_supported_wp_version" value="6.5"/>

    <!-- i18n: the two text domains this codebase actually ships. -->
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="braillewright"/>
            </property>
        </properties>
    </rule>

    <!--
        Global-prefix sniff. The fusion (2026-06-19) renamed the entire upstream
        ct_period / period namespace to braillewright, so braillewright is the only
        approved prefix (braillewright_features_* is covered by it). Adding a second,
        shorter one was tried on 2026-08-27 and is not possible - see the note inside
        the prefixes list for the measured reason.
    -->
    <!--
        ⛔ HOOK NAMES ARE EXEMPT, AND ONLY HOOK NAMES. Measured 2026-08-27.

        NonPrefixedHooknameFound reports 23 do_action() calls. Renaming any of them is a
        BREAKING CHANGE, because a hook name is a public API: it is the thing a child
        theme, a plugin or a site snippet attaches to. Six live sites migrated here from
        Period 1.750, where these names have existed since long before the fork.

        The 22 theme hooks are the template extension points, named for where they fire:
        body_top, before_header, after_header, main_top, main_bottom, footer_top,
        body_bottom, page_before, page_after, post_before, post_after,
        archive_post_before, archive_post_after, after_archive_header,
        sticky_post_status, attachment_before, attachment_after, theme_options_before,
        theme_options_after.

        ⚠️ AND THE 23rd IS NOT OURS AT ALL. header.php fires do_action('wp_body_open')
        inside the standard WordPress core shim:

            if ( function_exists( 'wp_body_open' ) ) { wp_body_open(); }
            else { do_action( 'wp_body_open' ); }

        That is CORE's hook, deliberately invoked for WordPress older than 5.2. Renaming
        it would break every plugin that hooks wp_body_open. The sniff is simply wrong
        about this one.

        Only the hookname message code is silenced. NonPrefixedVariableFound and
        NonPrefixedConstantFound stay ACTIVE and are still counted as work to do.
    -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedHooknameFound">
        <severity>0</severity>
    </rule>

    <!--
        ⛔ NonPrefixedVariableFound IS SCOPED OFF FOR TEMPLATE PARTIALS ONLY, 2026-08-28,
        because in those files THE SNIFF'S PREMISE IS FACTUALLY FALSE.

        The sniff assumes "top of file = global scope". That is true of a plugin bootstrap
        and it is NOT true of a WordPress template partial. Measured against WordPress
        core on the live host:

          wp-includes/template.php load_template() is a FUNCTION and the require happens
          INSIDE it. It declares exactly these globals and no others:
              $posts, $post, $wp_did_header, $wp_query, $wp_rewrite, $wpdb,
              $wp_version, $wp, $id, $comment, $user_ID
          get_template_part() -> locate_template($t, true, false) -> load_template()
          get_header()/get_footer() -> locate_template($t, true, true) -> load_template()

        So a top-level variable in any of the files below is a FUNCTION-LOCAL of
        load_template(), invisible outside that one require. The two widget-area partials
        are plainer still: features/inc/widget-areas.php:75 and :81 `include` them from
        inside a function, so they inherit that function's scope with no load_template and
        no extract() involved at all.

        ⭐ WHY SCOPE IT OFF RATHER THAN RENAME. Renaming the 43 would silence the finding
        without making it true - it would encode, in ten files forever, the claim that
        these are globals. Zero of them can produce the collision the sniff exists to
        prevent (verified by grep: every flagged name is confined to its own file). The
        cost was measured too, and it is not small: ~96 token edits, because every READ
        moves as well as every assignment, plus ~10 assignment blocks needing
        re-alignment since the approved prefix is 13 characters. That lands a large diff
        on precisely the files a site owner is most likely to copy into a child theme.

        ⚠️ search.php IS DELIBERATELY NOT LISTED. It is a MAIN template, reached by
        wp-includes/template-loader.php's bare `include $template;` at global scope, so
        its $total_results really was $GLOBALS['total_results']. That one is REAL and was
        fixed by renaming, not excluded. It is the only main template in the theme with
        any top-level assignment - index.php, 404.php, templates/full-width.php,
        templates/landing-page.php, templates/landing-page-header.php and woocommerce.php
        all have none, which is exactly why the report flagged only this one.

        The sniff stays ACTIVE everywhere its premise holds: tools/, functions.php,
        features/inc/*.php, inc/*.php and search.php.
    -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedVariableFound">
        <exclude-pattern>*/theme/braillewright/content/*\.php$</exclude-pattern>
        <exclude-pattern>*/theme/braillewright/content-attachment\.php$</exclude-pattern>
        <exclude-pattern>*/theme/braillewright/footer\.php$</exclude-pattern>
        <exclude-pattern>*/theme/braillewright/logo\.php$</exclude-pattern>
        <exclude-pattern>*/theme/braillewright/features/inc/widget-areas/*\.php$</exclude-pattern>
    </rule>

    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="braillewright"/>
                <!--
                    ⛔ THE `bw` PREFIX CANNOT BE ADDED HERE. Tried and measured 2026-08-27.

                    The four migration scripts under tools/ prefix their file-scope
                    variables `bw_` (commit 1204320 renamed them from bare $from / $to),
                    which produces 40 NonPrefixedVariableFound findings. Naming `bw` as a
                    second approved prefix looks like a one-line fix. It is not:

                      run 33109149953  <element value="bw"/>   ->  "The \"bw\" prefix is
                                                                   too short."
                      run 33109511822  <element value="bw_"/>  ->  "The \"bw_\" prefix is
                                                                   too short."

                    WPCS enforces a minimum prefix length of three characters and does not
                    count the trailing underscore. BOTH attempts cleared ZERO of the 40 and
                    each ADDED 8 new PrefixAllGlobals.ShortPrefixPassed findings, one per
                    file the sniff visits - a net-negative change that reads as a tidy
                    one-liner.

                    The 40 are real globals in procedural scripts, so the sniff is correct.
                    They are Stage 5 work: rename them to braillewright_*.
                -->
            </property>
        </properties>
    </rule>
</ruleset>
